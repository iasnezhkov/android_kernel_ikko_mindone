		opp34 {
			opp-hz = <0x00 0x269fb200>;
			opp-microvolt = <0xaae60>;
		};

		opp35 {
			opp-hz = <0x00 0x2512f780>;
			opp-microvolt = <0xa95f6>;
		};

		opp36 {
			opp-hz = <0x00 0x23863d00>;
			opp-microvolt = <0xa95f6>;
		};

		opp37 {
			opp-hz = <0x00 0x21f98280>;
