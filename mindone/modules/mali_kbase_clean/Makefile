# Stock mali (5.10.233, vendor_dlkm) installs GED hooks (ged_dvfs_gpu_freq_commit_fp,
# ged_dvfs_cal_gpu_utilization_ex_fp, ged_dvfs_set_gpu_core_mask_fp, mtk_notify_gpu_freq_change_fp):
# that is CONFIG_MALI_MTK_DVFS_POLICY + CONFIG_MALI_MTK_DVFS_LOADING_MODE. Without them GED has no
# load source and no commit sink, and the GPU never leaves its lowest OPP (390 MHz).
ccflags-y += -DCONFIG_MALI_REAL_HW=1 -DCONFIG_MALI_MIDGARD_DVFS=1 -DMALI_KERNEL_TEST_API=0 -DMALI_UNIT_TEST=0 -DMALI_CUSTOMER_RELEASE=1 -DCONFIG_MALI_DEVFREQ=1 -DCONFIG_DEBUG_FS=1 -DCONFIG_SYNC_FILE=1 -DCONFIG_GPU_MT6789=1 -DMALI_USE_CSF=0 -DMALI_KBASE_BUILD=1 -DCONFIG_MTK_GPUFREQ_V2=1 -DCONFIG_MALI_MTK_DVFS_POLICY=1 -DCONFIG_MALI_MTK_DVFS_LOADING_MODE=1
ccflags-y += -DMALI_RELEASE_NAME='"r32p1-01eac0"'
ccflags-y += -I$(src)/../include
ccflags-y += -I$(src)/../include
# MINDONE-GPUBM (12.09): GPU bandwidth monitor (JM) -- as in the stock
# mali_kbase_mt6789.ko (imports MTKGPUQoS_setup/sspm_reserve_mem_*). Init at probe only
# via the mindone_gpu_bm=1 parameter (default 0), otherwise -- manually through debugfs
# mali/mindone_gpu_bm_init (lazy, after SSPM/mtk_qos come up). An earlier attempt to
# enable the flag crashed the boot: SSPM reserved-memory cleanup on NULL before its
# ioremap -- now guarded.
# Side effect: struct base_jd_atom gains frame_nr (72 bytes), exactly what userspace
# sends (MINDONE-STRIDE72).
ccflags-y += -DCONFIG_MALI_MTK_GPU_BM_JM=1 -DCONFIG_MTK_TINYSYS_SSPM_SUPPORT=1
ccflags-y += -I$(src)/../include/drivers/gpu/mediatek/gpu_bm -I$(src)/../include/drivers/misc/mediatek/sspm/v3 -I$(src)/../include/drivers/misc/mediatek/sspm
